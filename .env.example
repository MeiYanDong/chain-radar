# Alchemy Base RPC (sign up at alchemy.com for free API key)
# Example: https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# Falls back to public RPC if not set
RPC_URL=
RPC_URL_FALLBACKS=

# CoinGecko API key (optional, free demo tier)
COINGECKO_API_KEY=

# Feishu custom bot webhook for Pot Monitor cards
FEISHU_WEBHOOK=
FEISHU_TIMEOUT_MS=8000
FEISHU_OUTBOX_BATCH_SIZE=20
FEISHU_OUTBOX_MAX_ATTEMPTS=20
FEISHU_URGENT_ENABLED=1
FEISHU_URGENT_MENTION_USER_ID=all

# Deprecated Android voice/alarm fallback through Pushover.
# Register at https://pushover.net/, install Android app, then fill app token + user key.
PUSHOVER_ENABLED=0
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_DEVICE=
PUSHOVER_TIMEOUT_MS=8000
PUSHOVER_P0_SOUND=siren
PUSHOVER_P1_SOUND=cashregister
PUSHOVER_P0_RETRY_SECONDS=30
PUSHOVER_P0_EXPIRE_SECONDS=300

# Official Pot data-source protection still runs when alerts are off:
# raw rows are saved, position advice pauses during broad anomalies, and logs remain.
# Feishu cards for "官网数据异常" and "数据异常/疑似归零" are disabled by default.
POT_DATA_SOURCE_ALERTS_ENABLED=0
POT_DATA_SOURCE_ANOMALY_MIN_ZERO_AGENTS=3
POT_DATA_SOURCE_DEGRADED_MIN_ZERO_AGENTS=2
POT_DATA_SOURCE_RECOVERY_CONFIRM_CYCLES=2
POT_SINGLE_AGENT_INVALID_ALERT_COOLDOWN_MINUTES=360

# Monitor interval and Selection Alpha notification defaults
MONITOR_INTERVAL_SECONDS=60
POT_AGENT_SNAPSHOT_RETENTION_HOURS=168
STARTUP_RECOVERY_LOOKBACK_HOURS=24
# Dedicated Live P&L + token price history for lag research.
POT_MARKET_SNAPSHOT_RETENTION_DAYS=30

# Independent data health watchdog. It is intended for the cloud server cron job.
# Keep Feishu disabled by default; the watchdog should log health only unless explicitly re-enabled.
DATA_HEALTH_ALERTS_ENABLED=0
# Separate critical incident channel. This is not a generic data-health notification:
# it only fires when Pot Live P&L / market snapshots stop updating or recover after an outage.
POT_MAINLINE_INCIDENT_ALERTS_ENABLED=1
POT_MAINLINE_INCIDENT_RECOVERY_ALERTS_ENABLED=1
POT_MAINLINE_INCIDENT_MENTION_USER_ID=all
POT_MAINLINE_INCIDENT_COOLDOWN_SECONDS=300
DATA_HEALTH_MAX_STALE_SECONDS=180
DATA_HEALTH_MAX_BATCH_GAP_SECONDS=180
DATA_HEALTH_MIN_RECENT_BATCHES=3
DATA_HEALTH_MIN_ROWS_PER_BATCH=10
DATA_HEALTH_ALERT_COOLDOWN_SECONDS=900
SELECTION_HIGH_SCORE=75
SELECTION_CRITICAL_MIN_SCORE=65
SELECTION_RISK_FLOOR_SCORE=70
SELECTION_DELTA_15M_SCORE=5
SELECTION_DELTA_1H_SCORE=8
SELECTION_RANK_TOP_STRONG=5
SELECTION_RANK_TOP_CRITICAL=10
SELECTION_RANK_UP_1H=5
SELECTION_PART_BOOST_SCORE=5
SELECTION_ALERT_COOLDOWN_MINUTES=30
SELECTION_CONFIRM_COOLDOWN_MINUTES=360
SELECTION_SNAPSHOT_RETENTION_HOURS=24
SELECTION_EXPECTATION_ALERTS_ENABLED=1
# Position model: every agent first gets its own cap from fundamental_ratio.
POSITION_CAP_U=200
POSITION_MIN_ACTION_U=10
# Default paused: keep calculating/saving target-position snapshots, but do not send position-adjustment cards.
# Set to 1 only when you want Feishu to actively suggest target-position changes again.
POSITION_ADVICE_ALERTS_ENABLED=0

# Buyback monitor: active only Beijing Monday 16:00 -> Monday 20:00 by default
BUYBACK_MONITOR_ENABLED=1
BUYBACK_EXECUTOR_ADDRESS=0x9Bda49389B29Fa4E204eD9De8f3d7d06f84dA171
BUYBACK_MONITOR_SOURCE=rpc
BUYBACK_MONITOR_INTERVAL_MS=30
BUYBACK_WINDOW_MODE=weekly
BUYBACK_WINDOW_START_DAY=1
BUYBACK_WINDOW_START_HOUR=16
BUYBACK_WINDOW_END_DAY=1
BUYBACK_WINDOW_END_HOUR=20
BUYBACK_FAST_BACKFILL_BLOCKS=3
BUYBACK_FAST_MAX_BLOCK_RANGE=20
BUYBACK_SCAN_LIMIT=120
BUYBACK_PRIME_HISTORY=1
BUYBACK_PRIME_GRACE_SECONDS=120
BUYBACK_RPC_TIMEOUT_MS=1200
# Pre-confirmation trigger path. This runs alongside confirmed-block RPC polling.
# When empty, the monitor derives a WSS endpoint from RPC_URL. Use a Flashblocks-aware provider WSS endpoint in production.
BUYBACK_FLASHBLOCKS_ENABLED=0
BUYBACK_FLASHBLOCKS_WS_URLS=
BUYBACK_FLASHBLOCKS_RECONNECT_MS=1000
# Black-swan fallback for changed buyback address: within the normal buyback window,
# trigger auto-sell when a whitelisted/preapproved token is bought with more than this VIRTUAL amount.
BUYBACK_LARGE_BUY_FALLBACK_ENABLED=0
BUYBACK_LARGE_BUY_THRESHOLD_VIRTUAL=3000
# Legacy USD threshold fallback. Keep 0 when VIRTUAL amount is the trigger source.
BUYBACK_LARGE_BUY_THRESHOLD_USD=0
BUYBACK_LARGE_BUY_SYMBOLS=
BUYBACK_LARGE_BUY_VIRTUAL_USD_FALLBACK=1.5

# Optional backup track when competing with pre-placed OKX Wallet / OKX DEX limit orders.
# Create/cancel those orders outside this monitor; this setting only makes readiness checks
# assert that declared OKX backup coverage exists.
OKX_LIMIT_ORDER_BACKUP_ENABLED=0
OKX_LIMIT_ORDER_PREPLACED_SYMBOLS=

# Auto sell executor. Put AUTO_SELL_PRIVATE_KEY only in local/server .env, never here.
AUTO_SELL_ENABLED=0
AUTO_SELL_DRY_RUN=0
AUTO_SELL_PERCENT=100
AUTO_SELL_MIN_OUT_MODE=reference
AUTO_SELL_REQUIRE_NONZERO_MIN_OUT=1
AUTO_SELL_SLIPPAGE_BPS=1500
AUTO_SELL_FALLBACK_MIN_OUT_ZERO=0
AUTO_SELL_VERIFY_QUOTES=0
AUTO_SELL_ON_DEMAND_APPROVE=1
AUTO_SELL_DEADLINE_SECONDS=30
# Sell through the configured market by default. Keep this off unless you intentionally want
# a detected buyback transaction to choose the sell contract.
AUTO_SELL_USE_TRIGGER_MARKET_ADDRESS=0
# Burst protection: detections may arrive concurrently, but a single wallet must submit txs with unique nonces.
AUTO_SELL_BURST_TARGET=3
AUTO_SELL_TOKEN_PENDING_LOCK=1
AUTO_SELL_TOKEN_PENDING_TTL_MS=180000
AUTO_SELL_FEE_MODE=dynamic
AUTO_SELL_MIN_PRIORITY_GWEI=0.01
AUTO_SELL_MAX_FEE_GWEI=
AUTO_SELL_MAX_PRIORITY_FEE_GWEI=
AUTO_SELL_PRIORITY_FEE_MULTIPLIER=2
AUTO_SELL_MAX_FEE_MULTIPLIER=1.5
AUTO_SELL_READ_TIMEOUT_MS=1200
AUTO_SELL_WRITE_TIMEOUT_MS=1800
# primary: submit sell through the first RPC; multi-rpc: sign once and broadcast the same sell tx to every configured RPC.
AUTO_SELL_SUBMIT_MODE=primary
AUTO_SELL_PROTECTED_RPC_URLS=
AUTO_SELL_FLASHBLOCKS_ENABLED=0
AUTO_SELL_FLASHBLOCKS_RPC_URLS=
AUTO_SELL_PUBLIC_BROADCAST_ENABLED=1
AUTO_SELL_PRIMARY_FALLBACK_ENABLED=1
# Fixed gas must be calibrated by a real direct sell before buyback-triggered tests.
AUTO_SELL_SELL_GAS_LIMIT=350000
# Optional: spender that receives ERC20 allowance. It can differ from the sell market contract.
AUTO_SELL_APPROVAL_SPENDER_ADDRESS=
AUTO_SELL_PREAPPROVED_ALLOWANCES=
AUTO_SELL_VERIFY_PREAPPROVED=0
AUTO_SELL_TOKEN_DECIMALS=
# Optional fast-path metadata. When both symbol and decimals are configured, buyback detection
# does not need extra ERC20 symbol()/decimals() RPC calls before submitting sell.
AUTO_SELL_TOKEN_SYMBOLS=

# Window-preflight readiness check. The watcher checks once during this Beijing-time window
# and sends a Feishu urgent alert only when blocking auto-sell problems are found.
AUTO_SELL_HEALTHCHECK_ENABLED=1
AUTO_SELL_HEALTHCHECK_DAY=1
AUTO_SELL_HEALTHCHECK_HOUR=15
AUTO_SELL_HEALTHCHECK_MINUTE=50
AUTO_SELL_HEALTHCHECK_WINDOW_MINUTES=10
AUTO_SELL_HEALTHCHECK_INTERVAL_SECONDS=60

# Block range per getLogs call (Alchemy supports 50000+, public RPC supports 10000)
BLOCK_RANGE_SIZE=10000
