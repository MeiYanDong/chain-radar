# Alchemy Base RPC (sign up at alchemy.com for free API key)
# Example: https://base-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# Falls back to public RPC if not set
RPC_URL=

# CoinGecko API key (optional, free demo tier)
COINGECKO_API_KEY=

# Block range per getLogs call (Alchemy supports 50000+, public RPC supports 10000)
BLOCK_RANGE_SIZE=10000
